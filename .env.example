# Copy this file to .env (same folder) and fill in your keys. .env is git-ignored.
# このファイルを同じフォルダに .env という名前でコピーし、キーを書き込んでください。.env は git に入りません。
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Meta Model API (Muse Spark); keys are created at dev.meta.ai/api-keys. Preview is open to US developers only.
MODEL_API_KEY=
# Discord (optional; docs/discord-setup.ja.md). Tokens and the webhook URL are secrets.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_TASKS_CHANNEL=
DISCORD_REPORTS_CHANNEL=
DISCORD_WIRE_WEBHOOK=
# optional: an agent's own bot account, and the channel it posts in
# DISCORD_WIRE_CHANNEL=
# DISCORD_TOKEN_CHIEF=
# DISCORD_TOKEN_WRITER=
# DISCORD_TOKEN_CRITIC=
# DISCORD_TOKEN_SCOUT=
