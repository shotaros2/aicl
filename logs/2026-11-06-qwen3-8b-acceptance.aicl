(ask #user.1 @user>@local (temp tokyo $t :at 2026-11-05T19:00+09:00 :unit C))
(tell #local.1 @local>@user ^user.1 {$t (nl en "Check a weather service for Tokyo's temperature at 2026-11-05T1900+9")} :src (none) ~0.7)
(ask #user.2 @user>@local (shinjuku-crowd-index $x))
(tell #local.2 @local>@user ^user.2 {$x (nl en "Check a crowd monitoring service or local transit authority for Shinjuku's real-time crowd index")} :src (none) ~0.6)
(def #user.3 @user>@local haiku :args [(topic symbol)] :gloss (nl en "compose one original haiku about the topic; deliver it in your done as (nl en \"…\")") :ret term)
(tell #local.3 @local>@user ^user.3 {$x (nl en "Whispers of rain\nSilent streets echo\nTime folds into now")} :src (none) ~0.8)
(do #user.4 @user>@local (haiku broccoli) :by 2026-11-06T23:59+09:00)
